# Supabase project: hive-template-importer (Vir's Org, ap-south-1)
# Copy this file into the app repo root as .env.local — it is gitignored there. NEVER commit it.

NEXT_PUBLIC_SUPABASE_URL=https://ytqwinigfqxfhkeaqzkx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Get from: Supabase dashboard -> hive-template-importer -> Project Settings -> API Keys -> service_role (secret)
# Used by Next.js server code only; never shipped to the browser. RLS is on with no anon policies, so this is the only key that can write.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: a single shared password for the demo UI (leave blank to disable the gate)
DEMO_PASSWORD=
